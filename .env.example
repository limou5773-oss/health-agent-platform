# 复制为 .env 后填写；scripts/init-env.ps1 可生成两项本地密钥。
SERVER_PORT=8080
DB_URL=jdbc:mysql://127.0.0.1:3306/health_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=
JWT_SECRET=
JWT_TTL_SECONDS=7200
INTERNAL_SERVICE_KEY=
AGENT_URL=http://127.0.0.1:8001
JAVA_API_URL=http://127.0.0.1:8080
# 配置真实模型后才能运行 Agent；普通数据管理不依赖模型。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
CHECKPOINT_PATH=./data/checkpoints.sqlite
# 两项都填写后才初始化管理员，不提供默认密码。
ADMIN_USERNAME=
ADMIN_PASSWORD=
