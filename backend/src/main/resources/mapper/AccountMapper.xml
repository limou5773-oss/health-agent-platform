<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.health.mapper.AccountMapper">
 <select id="byUsername" resultType="com.health.model.Models$User">SELECT * FROM users WHERE username=#{username}</select>
 <select id="byId" resultType="com.health.model.Models$User">SELECT * FROM users WHERE id=#{id}</select>
 <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO users(username,password_hash,nickname,role) VALUES(#{username},#{passwordHash},#{nickname},#{role})</insert>
 <insert id="insertProfile">INSERT INTO profiles(user_id) VALUES(#{id})</insert>
 <select id="profile" resultType="com.health.model.Models$Profile">SELECT p.*,u.nickname FROM profiles p JOIN users u ON u.id=p.user_id WHERE p.user_id=#{id}</select>
 <update id="updateProfile">UPDATE profiles SET height_cm=#{heightCm},weight_kg=#{weightKg},timezone=#{timezone},goal=#{goal},preferences=#{preferences},ai_consent=#{aiConsent} WHERE user_id=#{userId}</update>
 <update id="nickname">UPDATE users SET nickname=#{nickname} WHERE id=#{id}</update>
 <update id="password">UPDATE users SET password_hash=#{hash} WHERE id=#{id}</update>
 <select id="users" resultType="com.health.model.Models$User">SELECT id,username,nickname,role,enabled,created_at FROM users ORDER BY id DESC</select>
 <update id="status">UPDATE users SET enabled=#{enabled} WHERE id=#{id}</update>
</mapper>
