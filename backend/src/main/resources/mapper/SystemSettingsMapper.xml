<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.health.mapper.SystemSettingsMapper">
  <select id="get" resultType="com.health.model.SystemSettings">
    SELECT checkin_enabled,plan_due_enabled,report_enabled,data_change_enabled,import_failed_enabled,
      weekly_enabled,monthly_enabled,import_analysis_enabled,model_name,model_timeout_seconds
    FROM system_settings WHERE id=1
  </select>
  <update id="save">
    UPDATE system_settings SET checkin_enabled=#{checkinEnabled},plan_due_enabled=#{planDueEnabled},
      report_enabled=#{reportEnabled},data_change_enabled=#{dataChangeEnabled},import_failed_enabled=#{importFailedEnabled},
      weekly_enabled=#{weeklyEnabled},monthly_enabled=#{monthlyEnabled},import_analysis_enabled=#{importAnalysisEnabled},
      model_name=#{modelName},model_timeout_seconds=#{modelTimeoutSeconds} WHERE id=1
  </update>
</mapper>
